---
export const prerender = false;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="The Digicene is coming—an introduction to Earth’s newest age."
    />
    <title>The Digicene</title>
  </head>
  <body>
    <main class="hero">
      <video
        class="hero-video"
        autoplay
        muted
        loop
        playsinline
        preload="auto"
        aria-hidden="true"
      >
        <source src="/digicene-background.mp4" type="video/mp4" />
      </video>

      <div class="hero-shade" aria-hidden="true"></div>

      <h1 class="title" aria-label="The Digicene">
        <span class="title-the">The</span>
        <span class="title-name">Digicene</span>
      </h1>
    </main>
  </body>
</html>

<style>
  :root {
    color-scheme: dark;
    font-family: Arial, Helvetica, sans-serif;
    background: #111311;
    font-synthesis: none;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    width: 100%;
    min-height: 100%;
    margin: 0;
    overflow: hidden;
  }

  .hero {
    position: relative;
    display: grid;
    width: 100%;
    height: 100vh;
    height: 100svh;
    place-items: center;
    isolation: isolate;
    overflow: hidden;
    background: #111311;
  }

  .hero-video,
  .hero-shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-video {
    z-index: -2;
    object-fit: cover;
    transform: scale(1.015);
    filter: saturate(0.7) contrast(1.08);
  }

  .hero-shade {
    z-index: -1;
    background:
      linear-gradient(180deg, rgba(5, 7, 5, 0.28), rgba(5, 7, 5, 0.38)),
      radial-gradient(circle at center, transparent 15%, rgba(4, 6, 4, 0.3) 100%);
  }

  .title {
    display: flex;
    align-items: baseline;
    margin: 0;
    color: #fff;
    font-weight: 400;
    line-height: 0.9;
    text-align: center;
    text-transform: uppercase;
    text-shadow: 0 2px 28px rgba(0, 0, 0, 0.45);
  }

  .title-the {
    margin-right: 0.42em;
    font-size: clamp(0.72rem, 1.3vw, 1.35rem);
    letter-spacing: 0.28em;
  }

  .title-name {
    font-size: clamp(2.6rem, 8vw, 8.6rem);
    font-weight: 600;
    letter-spacing: 0.2em;
  }

  @media (max-width: 540px) {
    .title {
      flex-direction: column;
      align-items: flex-start;
    }

    .title-the {
      margin: 0 0 0.5rem 0.12em;
    }

    .title-name {
      font-size: clamp(2.4rem, 13vw, 4.4rem);
      letter-spacing: 0.12em;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-video {
      display: none;
    }

    .hero {
      background:
        radial-gradient(circle at 70% 25%, #5b705b, transparent 38%),
        linear-gradient(145deg, #101610, #263126 60%, #0c0f0c);
    }
  }
</style>
