    text-decoration: none;
    border-bottom: 1px solid rgba(23, 26, 22, 0.45);
  }

  .title {
    position: absolute;
    top: 50%;
    left: 50%;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin: 0;
