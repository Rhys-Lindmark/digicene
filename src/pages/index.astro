---
export const prerender = false;

const evidence = [
  {
    statement: "CO2 levels have increased from 275 to 425 ppm.",
    embed: "co2-long-term-concentration",
    embedParams: "time=0..2025",
    title: "Carbon dioxide concentration in the atmosphere",
  },
  {
    statement: "Half of the world’s arable land is now used for agriculture.",
    image: "/land-use-for-food.jpg",
    href: "https://ourworldindata.org/global-land-for-agriculture",
    linkLabel:
      "Explore Our World in Data’s research on global land use for agriculture",
    alt: "Diagram showing how the world’s surface and habitable land are used for food production.",
  },
  {
    label: "Mass",
    statement: "Anthropogenic mass is now greater than all biomass.",
    image: "/anthropogenic-mass.png",
    href: "https://www.nature.com/articles/s41586-020-3010-5",
    linkLabel:
      "Read the Nature study on human-made mass exceeding global biomass",
    alt: "Area chart showing anthropogenic mass overtaking the dry weight of all biomass around 2020.",
    padded: true,
  },
  {
    label: "Energy",
    statement: "Humans use 20 TW of energy. Life uses 100 TW.",
    embed: "global-primary-energy",
    title: "Global direct primary energy consumption",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="The Digicene is coming—an introduction to Earth’s newest age."
    />
    <title>The Digicene</title>
  </head>
  <body>
    <main>
      <section class="hero">
        <video
          class="hero-video is-active"
          autoplay
          muted
          playsinline
          preload="auto"
          aria-hidden="true"
        >
          <source src="/robot-clip.mp4" type="video/mp4" />
        </video>
        <video
          class="hero-video"
          muted
          playsinline
          preload="auto"
          aria-hidden="true"
        >
          <source src="/stargate-clip.mp4" type="video/mp4" />
        </video>
        <video
          class="hero-video"
          muted
          playsinline
          preload="auto"
          aria-hidden="true"
        >
          <source src="/coding-zoom.mp4" type="video/mp4" />
        </video>

        <div class="hero-shade" aria-hidden="true"></div>

        <h1 class="title" aria-label="The Digicene">
          <span class="title-article">The</span>
          <span class="title-name">Digicene</span>
        </h1>
      </section>

      <section class="token-ticker" aria-label="OpenRouter token throughput">
        <div class="token-ticker-inner" data-token-ticker>
          <p
            class="token-total"
            aria-label="Estimated OpenRouter tokens processed per second"
          >
            <strong>Cognitive throughput:</strong>
            <a
              class="token-link"
              href="https://openrouter.ai/rankings"
              target="_blank"
              rel="noreferrer"
            >
              <span data-token-total>—</span>
              <span>tok/s</span>
            </a>
          </p>
        </div>
      </section>

      <section class="epoch" aria-labelledby="epoch-heading">
        <div class="epoch-intro">
          <h2 id="epoch-heading">
            The Digicene is the next geological epoch, when computers become the
            main driver of planetary change.
          </h2>
        </div>

        <figure class="epoch-chart">
          <div
            class="timeline"
            role="img"
            aria-label="Timeline showing the Holocene from 11,700 years ago to 1850, followed by the Anthropocene from 1850 to present, and the transition into the Digicene."
          >
            <div class="timeline-era timeline-era--holocene">
              <strong>Holocene</strong>
              <span class="timeline-range">11,700 years ago — 1850</span>
            </div>
            <div class="timeline-era timeline-era--anthropocene">
              <strong>Anthropocene</strong>
              <span class="timeline-range">1850 — Present</span>
            </div>
            <div class="timeline-era timeline-era--digicene">
              <strong>Digicene</strong>
              <span class="timeline-range">Future</span>
            </div>
          </div>
        </figure>

        <div class="evidence">
          <p class="evidence-intro">In the Anthropocene...</p>
          {
            evidence.map((item) => (
              <article class="evidence-row">
                <div class="evidence-copy">
                  {item.label && (
                    <span class="evidence-label">{item.label}</span>
                  )}
                  <p>{item.statement}</p>
                </div>

                <figure class={`chart ${item.padded ? "chart--padded" : ""}`}>
                  {item.embed ? (
                    <iframe
                      class="owid-embed"
                      data-src={`https://ourworldindata.org/grapher/${item.embed}?embedded=true${item.embedParams ? `&${item.embedParams}` : ""}`}
                      title={item.title}
                      loading="lazy"
                    />
                  ) : item.href ? (
                    <a
                      href={item.href}
                      target="_blank"
                      rel="noreferrer"
                      aria-label={item.linkLabel}
                    >
                      <img src={item.image} alt={item.alt} loading="lazy" />
                    </a>
                  ) : (
                    <img src={item.image} alt={item.alt} loading="lazy" />
                  )}
                </figure>
              </article>
            ))
          }
        </div>
      </section>

      <section class="digicene-signals" aria-labelledby="signals-heading">
        <header class="signals-intro">
          <h2 id="signals-heading">
            The Digicene is just beginning, but the curves are exponential.
          </h2>
        </header>

        <div class="signals-list">
          <article class="signal-row">
            <div class="signal-copy">
              <span class="signal-number">Energy</span>
              <p>Data centers consume 50 GW, about 2% of all electricity.</p>
            </div>
            <figure class="signal-chart">
              <iframe
                class="owid-embed"
                data-src="https://ourworldindata.org/grapher/data-centers-share-electricity-demand?embedded=true"
                title="Share of total electricity demand used by data centers"
                loading="lazy"></iframe>
            </figure>
          </article>

          <article class="signal-row">
            <div class="signal-copy">
              <span class="signal-number">Mass</span>
              <p>We build more data centers than offices.</p>
            </div>
            <figure class="signal-chart signal-chart--dark signal-chart--fixed">
              <a
                href="https://x.com/josephpolitano/status/1951740903925715126"
                target="_blank"
                rel="noreferrer"
                aria-label="View data center vs office construction spending chart"
              >
                <img
                  src="/data-center-vs-office.png"
                  alt="Line chart showing US data center construction spending climbing to overtake office construction spending, accelerating after the ChatGPT launch."
                  loading="lazy"
                />
              </a>
            </figure>
          </article>

          <article class="signal-row">
            <div class="signal-copy">
              <span class="signal-number">Computation</span>
              <p>There are 25M H100e chips, 0.3% of human brainpower.</p>
            </div>
            <figure class="signal-chart">
              <a
                href="https://epoch.ai/data/ai-chip-sales?view=graph&tab=h100_equivalents"
                target="_blank"
                rel="noreferrer"
                aria-label="Explore Epoch AI data on AI chip sales"
              >
                <img
                  src="/ai-chip-sales.png"
                  alt="Bar chart showing cumulative AI chip sales in H100 equivalents, growing from about 1M in early 2024 to over 24M by early 2026."
                  loading="lazy"
                />
              </a>
            </figure>
          </article>

          <article class="signal-row">
            <div class="signal-copy">
              <p>Claude codes 4% of public GitHub commits.</p>
            </div>
            <figure class="signal-chart signal-chart--dark">
              <a
                href="https://newsletter.semianalysis.com/p/claude-code-is-the-inflection-point"
                target="_blank"
                rel="noreferrer"
                aria-label="Read SemiAnalysis on Claude Code reaching 4% of public GitHub commits"
              >
                <img
                  src="/claude-github-commits.jpg"
                  alt="Line chart showing Claude Code's daily GitHub commits growing from near zero to over 134,000 per day, roughly 4% of all public GitHub commits."
                  loading="lazy"
                />
              </a>
            </figure>
          </article>

          <article class="signal-row">
            <div class="signal-copy">
              <p>See this video for a deeper dive into the Digicene.</p>
            </div>
            <figure class="signal-chart signal-chart--video">
              <a
                href="https://www.youtube.com/watch?v=g2BAKx2Rr-E"
                target="_blank"
                rel="noreferrer"
                aria-label="Watch a deeper dive into the Digicene on YouTube"
              >
                <img
                  src="/digicene-video.jpg"
                  alt="YouTube video thumbnail showing a glowing sphere split between orange light and darkness."
                  loading="lazy"
                />
              </a>
            </figure>
          </article>
        </div>
      </section>
    </main>

    <script>
      const owidObserver = new IntersectionObserver(
        (entries, observer) => {
          for (const entry of entries) {
            if (!entry.isIntersecting) continue;
            const iframe = entry.target as HTMLIFrameElement;
            const src = iframe.dataset.src;
            if (src) iframe.src = src;
            observer.unobserve(iframe);
          }
        },
        { rootMargin: "200px" },
      );

      document
        .querySelectorAll<HTMLIFrameElement>("iframe.owid-embed[data-src]")
        .forEach((iframe) => owidObserver.observe(iframe));

      const heroVideos = Array.from(
        document.querySelectorAll<HTMLVideoElement>(".hero-video"),
      );
      const clipDuration = 6;
      const transitionDuration = 2;

      const playVideo = async (video: HTMLVideoElement) => {
        video.muted = true;
        video.defaultMuted = true;
        video.playsInline = true;

        try {
          await video.play();
          return true;
        } catch {
          return false;
        }
      };

      const transitionToNext = async (
        video: HTMLVideoElement,
        index: number,
      ) => {
        if (video.dataset.transitioning === "true") return;

        const nextVideo = heroVideos[(index + 1) % heroVideos.length];
        if (!nextVideo) return;

        video.dataset.transitioning = "true";
        nextVideo.currentTime = 0;

        if (!(await playVideo(nextVideo))) {
          video.dataset.transitioning = "false";
          video.currentTime = 0;
          await playVideo(video);
          return;
        }

        nextVideo.classList.add("is-active");
        video.classList.remove("is-active");

        window.setTimeout(() => {
          video.pause();
          video.currentTime = 0;
          video.dataset.transitioning = "false";
        }, transitionDuration * 1000);
      };

      heroVideos.forEach((video, index) => {
        video.addEventListener("timeupdate", () => {
          if (video.currentTime >= clipDuration) {
            void transitionToNext(video, index);
          }
        });

        video.addEventListener("ended", () => {
          void transitionToNext(video, index);
        });
      });

      const firstVideo = heroVideos[0];
      if (firstVideo) {
        const startHero = () => void playVideo(firstVideo);

        if (firstVideo.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA) {
          startHero();
        } else {
          firstVideo.addEventListener("loadeddata", startHero, { once: true });
        }

        document.addEventListener("pointerdown", startHero, { once: true });
      }

      type TokenSummary = {
        tokensPerSecond: number;
      };

      const ticker = document.querySelector<HTMLElement>("[data-token-ticker]");
      const total = ticker?.querySelector<HTMLElement>("[data-token-total]");
      const tokenFormatter = new Intl.NumberFormat("en-US", {
        maximumFractionDigits: 0,
      });

      const updateTokenTicker = async () => {
        if (!ticker || !total) return;

        try {
          const response = await fetch("/api/openrouter-tokens");
          if (!response.ok) throw new Error("Token data unavailable");
          const summary = (await response.json()) as TokenSummary;

          const phase = Math.random() * Math.PI * 2;
          let lastUpdate = 0;
          const render = (timestamp: number) => {
            if (timestamp - lastUpdate >= 80) {
              const seconds = timestamp / 1000;
              const noise =
                Math.sin(seconds * 0.8 + phase) * 0.022 +
                Math.sin(seconds * 2.1 + phase * 0.7) * 0.009 +
                Math.sin(seconds * 0.19 + phase * 1.4) * 0.016;
              const estimate = summary.tokensPerSecond * (1 + noise);
              total.textContent = tokenFormatter.format(Math.round(estimate));
              lastUpdate = timestamp;
            }
            window.requestAnimationFrame(render);
          };

          window.requestAnimationFrame(render);
        } catch {
          total.textContent = "—";
        }
      };

      void updateTokenTicker();
    </script>
  </body>
</html>

<style>
  :root {
    color-scheme: dark;
    font-family: Arial, Helvetica, sans-serif;
    background: #111311;
    font-synthesis: none;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    width: 100%;
    min-height: 100%;
    margin: 0;
  }

  body {
    overflow-x: hidden;
  }

  .hero {
    position: relative;
    display: grid;
    width: 100%;
    height: 100vh;
    height: 100svh;
    place-items: center;
    isolation: isolate;
    overflow: hidden;
    background: #111311;
  }

  .hero-video,
  .hero-shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-video {
    z-index: -2;
    object-fit: cover;
    transform: scale(1.015);
    filter: saturate(0.7) contrast(1.08);
    opacity: 0;
    transition: opacity 2s ease-in-out;
  }

  .hero-video.is-active {
    opacity: 1;
  }

  .hero-shade {
    z-index: -1;
    background:
      linear-gradient(180deg, rgba(5, 7, 5, 0.28), rgba(5, 7, 5, 0.38)),
      radial-gradient(
        circle at center,
        transparent 15%,
        rgba(4, 6, 4, 0.3) 100%
      );
  }

  .token-ticker {
    --ticker-ink: #171a16;
    padding: clamp(1.4rem, 2.5vw, 2.25rem) clamp(1.25rem, 5vw, 5.5rem);
    color: var(--ticker-ink);
    background: #eeece4;
    border-top: 1px solid rgba(23, 26, 22, 0.18);
    border-bottom: 0;
  }

  .token-ticker-inner {
    width: min(100%, 90rem);
    margin-inline: auto;
    text-align: left;
  }

  .token-total {
    display: flex;
    gap: 0.3em;
    align-items: baseline;
    justify-content: flex-start;
    margin: 0;
    font-size: clamp(1rem, 1.6vw, 1.4rem);
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
    letter-spacing: -0.02em;
    flex-wrap: wrap;
  }

  .token-link {
    display: inline-flex;
