    color: var(--signal-ink);
    background:
      radial-gradient(
        circle at 92% 4%,
        rgba(93, 132, 99, 0.28),
        transparent 28rem
      ),
      #121713;
  }

  .signals-intro,
  .signals-list {
    width: min(100%, 90rem);
    margin-inline: auto;
  }

  .signals-intro {
