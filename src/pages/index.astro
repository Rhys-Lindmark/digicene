    margin: 0;
    color: #fff;
    font-weight: 400;
    line-height: 0.9;
    text-align: center;
    text-transform: uppercase;
    text-shadow: 0 2px 28px rgba(0, 0, 0, 0.45);
  }

  .title-the {
    margin-right: 0.42em;
    font-size: clamp(0.72rem, 1.3vw, 1.35rem);
    letter-spacing: 0.28em;
  }

  .title-name {
    font-size: clamp(2.6rem, 8vw, 8.6rem);
    font-weight: 600;
    letter-spacing: 0.2em;
  }

  .epoch {
    --ink: #171a16;
    --paper: #eeece4;
    padding: clamp(5rem, 10vw, 10rem) clamp(1.25rem, 5vw, 5.5rem)
