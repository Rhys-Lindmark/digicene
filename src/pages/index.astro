    margin: 0;
    font-size: clamp(2.45rem, 5.8vw, 6.2rem);
    font-weight: 400;
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .epoch-transition {
    max-width: 31ch;
    margin: clamp(2.5rem, 5vw, 5rem) 0 0 auto;
    font-size: clamp(1.25rem, 2.2vw, 2rem);
    line-height: 1.25;
    letter-spacing: -0.025em;
  }

  .epoch-chart {
    margin-bottom: clamp(6rem, 12vw, 12rem);
  }

  .epoch-chart-header {
    display: grid;
    grid-template-columns: 1fr auto;
