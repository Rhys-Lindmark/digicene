    background: var(--paper);
  }

  .epoch-intro,
  .epoch-chart,
  .evidence {
    width: min(100%, 90rem);
    margin-inline: auto;
  }

  .epoch-intro {
    padding-bottom: clamp(5rem, 10vw, 10rem);
  }

  .eyebrow,
  .evidence-number {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .eyebrow {
    margin: 0 0 clamp(2rem, 5vw, 4.75rem);
  }

  .epoch h2 {
