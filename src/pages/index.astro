  .title-article {
    margin: 0 0 0.35rem;
    font-size: clamp(0.75rem, 1.3vw, 1.35rem);
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .title-name {
    font-size: clamp(2.6rem, 8vw, 8.6rem);
    font-weight: 600;
    letter-spacing: 0.2em;
  }

  .epoch {
    --ink: #171a16;
    --paper: #eeece4;
    padding: clamp(5rem, 10vw, 10rem) clamp(1.25rem, 5vw, 5.5rem) 0;
    color: var(--ink);
    background: var(--paper);
  }

  .epoch-intro,
  .epoch-chart,
