---
export const prerender = false;

const evidence = [
  {
    number: "01",
    statement: "CO2 levels have increased from 275 to 425 ppm.",
    image: "/co2-concentration.png",
    alt: "Line chart showing atmospheric carbon dioxide concentration rising from about 275 ppm to more than 425 ppm.",
  },
  {
    number: "02",
    statement: "Half of the world’s arable land is now used for agriculture.",
    image: "/land-use-for-food.jpg",
    alt: "Diagram showing how the world’s surface and habitable land are used for food production.",
  },
  {
    number: "03",
    statement: "Anthropogenic mass is now greater than all biomass.",
    image: "/anthropogenic-mass.png",
    alt: "Area chart showing anthropogenic mass overtaking the dry weight of all biomass around 2020.",
  },
  {
    number: "04",
    statement:
      "Human energy use has grown from 1 to 20 TW, compared to 100 TW for the biosphere.",
    image: "/global-primary-energy.png",
    alt: "Stacked area chart showing global primary energy use by source rising sharply since 1800.",
  },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="The Digicene is coming—an introduction to Earth’s newest age."
    />
    <title>The Digicene</title>
  </head>
  <body>
    <main>
      <section class="hero">
        <video
          class="hero-video is-active"
          autoplay
          muted
          playsinline
          preload="auto"
          aria-hidden="true"
        >
          <source src="/robot-clip.mp4" type="video/mp4" />
        </video>
        <video
          class="hero-video"
          muted
          playsinline
          preload="auto"
          aria-hidden="true"
        >
          <source src="/stargate-clip.mp4" type="video/mp4" />
        </video>
        <video
          class="hero-video"
          muted
          playsinline
          preload="auto"
          aria-hidden="true"
        >
          <source src="/coding-zoom.mp4" type="video/mp4" />
        </video>

        <div class="hero-shade" aria-hidden="true"></div>

        <h1 class="title" aria-label="The Digicene">
          <span class="title-the">The</span>
          <span class="title-name">Digicene</span>
        </h1>
      </section>

      <section class="epoch" aria-labelledby="epoch-heading">
        <div class="epoch-intro">
          <p class="eyebrow">A new geological epoch</p>
          <h2 id="epoch-heading">
            The Digicene is the next geological epoch, when computers become the
            main driver of planetary change.
          </h2>
          <p class="epoch-transition">
            It follows our current epoch, the Holocene, which began in 1850.
          </p>
        </div>

        <figure class="epoch-chart" aria-labelledby="timeline-heading">
          <figcaption class="epoch-chart-header">
            <p class="eyebrow">The road of time</p>
            <h3 id="timeline-heading">Three planetary ages</h3>
            <p>Conceptual timeline · not to scale</p>
          </figcaption>

          <div
            class="timeline"
            role="img"
            aria-label="Timeline showing the Pleistocene followed by the Holocene beginning in 1850, and an uncertain transition into the Digicene."
          >
            <div class="timeline-era timeline-era--pleistocene">
              <span class="timeline-index" aria-hidden="true">01</span>
              <strong>Pleistocene</strong>
              <span class="timeline-range">Deep past — 1849</span>
            </div>
            <div class="timeline-era timeline-era--holocene">
              <span class="timeline-index" aria-hidden="true">02</span>
              <strong>Holocene</strong>
              <span class="timeline-range">1850 — uncertain</span>
            </div>
            <div class="timeline-era timeline-era--digicene">
              <span class="timeline-index" aria-hidden="true">03</span>
              <strong>Digicene</strong>
              <span class="timeline-range">Start date unclear</span>
            </div>
          </div>

          <div class="timeline-dates" aria-hidden="true">
            <span>1850</span>
            <span>?</span>
          </div>
        </figure>

        <div class="evidence">
          {
            evidence.map((item) => (
              <article class="evidence-row">
                <div class="evidence-copy">
                  <span class="evidence-number" aria-hidden="true">
                    {item.number}
                  </span>
                  <p>{item.statement}</p>
                </div>

                <figure class="chart">
                  <img src={item.image} alt={item.alt} loading="lazy" />
                </figure>
              </article>
            ))
          }
        </div>
      </section>

      <section class="digicene-signals" aria-labelledby="signals-heading">
        <header class="signals-intro">
          <p class="eyebrow">Signals of the Digicene</p>
          <h2 id="signals-heading">
            We don’t know exactly when it begins. We can see the curves.
          </h2>
          <p>
            Across energy, mass, and computation, the physical footprint of AI
            is growing exponentially.
          </p>
        </header>

        <div class="signals-list">
          <article class="signal-row">
            <div class="signal-copy">
              <span class="signal-number">01 / Energy</span>
              <p>Data centers consume 50 GW—about 2% of all electricity.</p>
            </div>
            <figure class="signal-chart">
              <a
                href="https://www.reddit.com/r/EconomyCharts/comments/1qee6rd/us_data_centers_will_consume_nearly_10_of_the/#lightbox"
                target="_blank"
                rel="noreferrer"
                aria-label="View data center electricity consumption chart"
              >
                <img
                  src="/data-center-energy.jpg"
                  alt="Line chart showing data center electricity consumption rising steeply, particularly in the United States."
                  loading="lazy"
                />
              </a>
            </figure>
          </article>

          <article class="signal-row">
            <div class="signal-copy">
              <span class="signal-number">02 / Mass</span>
              <p>We now build more data centers than offices.</p>
            </div>
            <figure class="signal-chart signal-chart--dark">
              <a
                href="https://assets.bwbx.io/images/users/iqjWHBFdfxIU/iBh.U2iTtpyA/v3/piL.vZNnk8fG1FJf0SN7xW9FmdjS0dnCrU/-1x-1.png"
                target="_blank"
                rel="noreferrer"
                aria-label="View data center construction spending chart"
              >
                <img
                  src="/data-center-construction.jpg"
                  alt="Line chart showing data center construction spending overtaking general office construction spending in December 2025."
                  loading="lazy"
                />
              </a>
            </figure>
          </article>

          <article class="signal-row">
            <div class="signal-copy">
              <span class="signal-number">03 / Computation</span>
              <p>AI has reached roughly 0.3% of human brainpower.</p>
            </div>
            <a
              class="compute-chart"
              href="https://epoch.ai/data/ai-chip-sales?view=graph&tab=h100_equivalents"
              target="_blank"
              rel="noreferrer"
              aria-label="Explore Epoch AI data on AI chip sales"
            >
              <div class="compute-total compute-total--ai">
                <span>AI</span>
                <strong>25M</strong>
                <small>H100 equivalents</small>
              </div>
              <div class="compute-ratio" aria-hidden="true">
                <span></span>
              </div>
              <div class="compute-total compute-total--human">
                <span>Humanity</span>
                <strong>8B</strong>
                <small>human brains</small>
              </div>
              <p>Both roughly 1 PFLOP each</p>
            </a>
          </article>
        </div>
      </section>
    </main>

    <script>
      const heroVideos = Array.from(
        document.querySelectorAll<HTMLVideoElement>(".hero-video"),
      );
      const clipDuration = 6;
      const transitionDuration = 2;

      const playVideo = async (video: HTMLVideoElement) => {
        video.muted = true;
        video.defaultMuted = true;
        video.playsInline = true;

        try {
          await video.play();
          return true;
        } catch {
          return false;
        }
      };

      const transitionToNext = async (
        video: HTMLVideoElement,
        index: number,
      ) => {
        if (video.dataset.transitioning === "true") return;

        const nextVideo = heroVideos[(index + 1) % heroVideos.length];
        if (!nextVideo) return;

        video.dataset.transitioning = "true";
        nextVideo.currentTime = 0;

        if (!(await playVideo(nextVideo))) {
          video.dataset.transitioning = "false";
          video.currentTime = 0;
          await playVideo(video);
          return;
        }

        nextVideo.classList.add("is-active");
        video.classList.remove("is-active");

        window.setTimeout(() => {
          video.pause();
          video.currentTime = 0;
          video.dataset.transitioning = "false";
        }, transitionDuration * 1000);
      };

      heroVideos.forEach((video, index) => {
        video.addEventListener("timeupdate", () => {
          if (video.currentTime >= clipDuration) {
            void transitionToNext(video, index);
          }
        });

        video.addEventListener("ended", () => {
          void transitionToNext(video, index);
        });
      });

      const firstVideo = heroVideos[0];
      if (firstVideo) {
        const startHero = () => void playVideo(firstVideo);

        if (firstVideo.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA) {
          startHero();
        } else {
          firstVideo.addEventListener("loadeddata", startHero, { once: true });
        }

        document.addEventListener("pointerdown", startHero, { once: true });
      }
    </script>
  </body>
</html>

<style>
  :root {
    color-scheme: dark;
    font-family: Arial, Helvetica, sans-serif;
    background: #111311;
    font-synthesis: none;
  }

  * {
    box-sizing: border-box;
  }

  html,
  body {
    width: 100%;
    min-height: 100%;
    margin: 0;
  }

  body {
    overflow-x: hidden;
  }

  .hero {
    position: relative;
    display: grid;
    width: 100%;
    height: 100vh;
    height: 100svh;
    place-items: center;
    isolation: isolate;
    overflow: hidden;
    background: #111311;
  }

  .hero-video,
  .hero-shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .hero-video {
    z-index: -2;
    object-fit: cover;
    transform: scale(1.015);
    filter: saturate(0.7) contrast(1.08);
    opacity: 0;
    transition: opacity 2s ease-in-out;
  }

  .hero-video.is-active {
    opacity: 1;
  }

  .hero-shade {
    z-index: -1;
    background:
