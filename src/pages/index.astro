    align-items: start;
    padding: clamp(3rem, 7vw, 7rem) 0;
    border-bottom: 1px solid rgba(241, 238, 229, 0.24);
  }

  .signal-copy {
    display: flex;
    flex-direction: column;
    min-height: 100%;
  }

  .signal-number {
    margin-bottom: clamp(2rem, 5vw, 5rem);
    color: var(--signal-muted);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.13em;
