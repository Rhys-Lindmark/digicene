# Safe local default: generates simulated utterances and spends nothing.
CHORUS_MOCK_MODE=true

# Set CHORUS_MOCK_MODE=false and supply a server-only OpenRouter key in production.
OPENROUTER_API_KEY=

# A long random value required by /api/admin/* and the diagnostics page.
CHORUS_ADMIN_TOKEN=

# Must point to storage shared by the web process and the one worker process.
CHORUS_DB_PATH=./data/chorus.db

# Used only as OpenRouter request attribution; never include a secret here.
PUBLIC_SITE_URL=http://localhost:4321

# Emergency server-side stop. Existing utterances continue to replay.
CHORUS_KILL_SWITCH=false
